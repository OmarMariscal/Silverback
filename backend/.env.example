# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
DB_USER="tu_usuario_local"
DB_PASSWORD="tu_password_local"
DB_NAME="tu_base_de_datos"
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}?schema=public"

# ENTORNO DE EJECUCIÓN
# development | production | test
NODE_ENV="development" 

# ALMACENAMIENTO DE EVIDENCIAS (MinIO / AWS S3)
# En desarrollo (MinIO) la región es irrelevante, pero el SDK de AWS la exige. En prod usar la real (ej. us-east-2)
S3_REGION="us-east-1"
S3_ACCESS_KEY="minio_dev_user"
S3_SECRET_KEY="minio_dev_password"
S3_BUCKET_NAME="silverback-evidencias"

# [MODO DESARROLLO - MinIO]
# S3_ENDPOINT es para la comunicación Backend -> MinIO dentro de la red de Docker (HeadObject, DeleteObject)
S3_ENDPOINT="http://s3_storage:8333"
# S3_PUBLIC_ENDPOINT es la URL que usará el Frontend/Navegador para subir/descargar (Pre-Signed URLs)
S3_PUBLIC_ENDPOINT="http://localhost:9000"
# S3_FORCE_PATH_STYLE debe ser "true" para MinIO y "false" para AWS S3
S3_FORCE_PATH_STYLE="true"

# [MODO PRODUCCIÓN - AWS S3]
# Para producción, S3_ENDPOINT y S3_PUBLIC_ENDPOINT deben quedar vacíos o comentados,
# y S3_FORCE_PATH_STYLE debe ser "false".
    "/api/v1/actividades/proximas-vencer": {
      "get": {
        "description": "Retorna un listado de las actividades cuya fecha de término está más cerca",
        "operationId": "ActividadesController_getSubActividadesProximasAVencer",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Cantidad máxima de actividades a retornar para la interfaz",
            "schema": {
              "default": 4,
              "example": 4,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista recuperada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubActividadesProximasVencerResponse"
                }
              }
            }
          },
          "403": {
            "description": "Rol no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Actividades próximas a vencer",
        "tags": [
          "Actividades"
        ]
      }
    },
    "/api/v1/actividades/supervision": {
      "get": {
        "description": "Datos de las sub-actividades recientemente devueltas para la construcción de la tabla inferior del dashboard del contralor",
        "operationId": "ActividadesController_getActividadesSupervision",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Página actual",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Cantidad de registros por página",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "type": "number"
            }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "schema": {
              "default": "desc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActividadesSupervicionGetResponse"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Obtener actividades devueltas para el dashboard",
        "tags": [
          "Actividades"
        ]
      }
    },
    "/api/v1/actividades/{actividadId}/resumen": {
      "get": {
        "description": "Obtener los detalles técnicos de una actividad principal",
        "operationId": "ActividadesController_getResumen",
        "parameters": [
          {
            "name": "actividadId",
            "required": true,
            "in": "path",
            "description": "El identificador único (UUID) de la actividad principal",
            "schema": {
              "format": "uuid",
              "example": "act-uuid-1",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ficha técnica recuperada con éxito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActividadesResumenResponse"
                }
              }
            }
          },
          "404": {
            "description": "UUID no identificado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Detalles técnicos",
        "tags": [
          "Actividades"
        ]
      }
    },
    "/api/v1/actividades/directorio": {
      "get": {
        "description": "Listado de las actividades para la construcción de los dashboards",
        "operationId": "ActividadesController_getActividadesDirectorio",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Página actual",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Cantidad de registros por página",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "type": "number"
            }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "schema": {
              "default": "desc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "sort_by",
            "required": false,
            "in": "query",
            "schema": {
              "default": "fecha_termino",
              "type": "string",
              "enum": [
                "identificador",
                "fecha_termino",
                "estado_flujo"
              ]
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Búsqueda libre por texto o identificador",
            "schema": {
              "example": "Auditoria 055",
              "type": "string"
            }
          },
          {
            "name": "centro_uuid",
            "required": false,
            "in": "query",
            "description": "Identificador único (UUID) del centro universitario",
            "schema": {
              "example": "centro-uuid-1",
              "type": "string"
            }
          },
          {
            "name": "tipo_actividad",
            "required": false,
            "in": "query",
            "description": "Tipo de actividad asingado",
            "schema": {
              "example": "AUDITORIA",
              "type": "string",
              "enum": [
                "AUDITORIA",
                "REVISION"
              ]
            }
          },
          {
            "name": "estado_flujo",
            "required": false,
            "in": "query",
            "description": "Estado de la sub-actividad",
            "schema": {
              "example": "EN_PROGRESO",
              "type": "string",
              "enum": [
                "SIN_EMPEZAR",
                "SOLICITADO",
                "EN_PROGRESO",
                "EN_REVISION",
                "DEVUELTA",
                "CONCLUIDA"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActividadesDirectorioResponse"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Directorio de Actividades",
        "tags": [
          "Actividades"
        ]
      }
    },
    "/api/v1/actividades/{actividadId}/sub-actividades/bulk": {
      "post": {
        "description": "Sincronización de las subactividades seleccionadas",
        "operationId": "ActividadesController_postSubActividadesBulk",
        "parameters": [
          {
            "name": "actividadId",
            "required": true,
            "in": "path",
            "description": "El identificador único (UUID) de la actividad a la que van dirigidas las sub-actividades",
            "schema": {
              "format": "uuid",
              "example": "act-01-uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubActividadesBulkRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Actividades agregadas exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubActividadesBulkResponse"
                }
              }
            }
          },
          "403": {
            "description": "Rol no autorizado para esta operación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Selección de subactividades",
        "tags": [
          "Actividades"
        ]
      }
    },
    "/api/v1/actividades/{actividadId}/sub-actividades/sync": {
      "put": {
        "description": "Endpoint único para sincronizar varios cambios de una actividad principal objetivo",
        "operationId": "ActividadesController_putSubActividadesSync",
        "parameters": [
          {
            "name": "actividadId",
            "required": true,
            "in": "path",
            "description": "Identificador único (UUID) de la actividad principal",
            "schema": {
              "format": "uuid",
              "example": "sub-uuid-1",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubActividadesSyncRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sincronización realizada con éxito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubActividadesSyncResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación de la estructura JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "UUID no coincide con una sub-actividad",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Edición de múltiples sub-actividades",
        "tags": [
          "Actividades"
        ]
      }
    },

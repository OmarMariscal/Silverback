  "info": {
    "title": "API Silverback <3",
    "description": "Especificación técnica de los endpoints para auditoría, gestión documental y reportes.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ActividadesResumenDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID unico de la actividad",
            "example": "act-01-uuid"
          },
          "folio": {
            "type": "string",
            "description": "Numero de folio de la actividad",
            "example": "01"
          },
          "titulo": {
            "type": "string",
            "description": "Titulo de la actividad",
            "example": "Abatir el rezago en la solventación..."
          },
          "participacion_global": {
            "type": "number",
            "description": "Porcentaje de participacion en la actividad",
            "example": 50
          },
          "auditores_nombres": {
            "description": "Lista con nombres de los auditores",
            "example": [
              "Lic. Auditor Auxiliar",
              "Mtro. Titular"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "folio",
          "titulo",
          "participacion_global",
          "auditores_nombres"
        ]
      },
      "PoaActualDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID unico de la POA actual",
            "example": "poa-2026-uuid"
          },
          "anio_fiscal": {
            "type": "number",
            "description": "Anio fiscal en la que se encuentra la POA",
            "example": 2026
          },
          "estado": {
            "type": "string",
            "enum": [
              "SIN ENVIAR",
              "EN REVISION",
              "DEVUELTA",
              "ACEPTADA",
              "BORRADOR"
            ],
            "description": "Estado de la actividad(enum)",
            "example": "BORRADOR"
          },
          "actividades_resumen": {
            "description": "Lista de acrividades de manera resumida",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActividadesResumenDto"
            }
          }
        },
        "required": [
          "id",
          "anio_fiscal",
          "estado",
          "actividades_resumen"
        ]
      },
      "EquipoAuditorDto": {
        "type": "object",
        "properties": {
          "total_participantes": {
            "type": "number",
            "description": "Numero de participantes en la actividad",
            "example": 2
          },
          "auditores_ids": {
            "description": "Lista con los IDs de los auditores que participaran en la actividad",
            "example": [
              "uuid-auditor-1",
              "uuid-auditor-2"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "total_participantes",
          "auditores_ids"
        ]
      },
      "CrearActividadesDto": {
        "type": "object",
        "properties": {
          "banco_actividad_id": {
            "type": "string",
            "description": "ID de la actividad dentro del banco de actividades",
            "example": "banco-uuid-1"
          },
          "titulo": {
            "type": "string",
            "description": "Titulo de la actividad",
            "example": "Revisión al rubro de Obra Pública"
          },
          "justificacion": {
            "type": "string",
            "description": "Justificacion del porque de la Actividad",
            "example": "Verificar el adecuado cumplimiento en mi Centro Universitario..."
          },
          "objetivo_general": {
            "type": "string",
            "description": "Objetivo de la actividad",
            "example": 2026
          },
          "equipo_auditor": {
            "description": "Informacion sobre el equipo de participantes en esta actividad",
            "allOf": [
              {
                "$ref": "#/components/schemas/EquipoAuditorDto"
              }
            ]
          }
        },
        "required": [
          "banco_actividad_id",
          "titulo",
          "justificacion",
          "objetivo_general",
          "equipo_auditor"
        ]
      },
      "CrearActividadesResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID de la nueva actividad agregada",
            "example": "act-nueva-uuid-999"
          },
          "folio": {
            "type": "string",
            "description": "Folio de la nueva actividad agregada",
            "example": "03"
          },
          "mensaje": {
            "type": "string",
            "description": "Mensaje API de que la accion fue completada con exito",
            "example": "Actividad guardada exitosamente."
          }
        },
        "required": [
          "id",
          "folio",
          "mensaje"
        ]
      },
      "PresentarPoasDataDto": {
        "type": "object",
        "properties": {
          "poa_id": {
            "type": "string",
            "description": "ID de la POA a presentar",
            "example": "uuid-poa-1234"
          },
          "estado_anterior": {
            "type": "string",
            "description": "Estado anterior de la POA",
            "example": "BORRADOR"
          },
          "estado_nuevo": {
            "type": "string",
            "description": "Estado nuevo de la POA",
            "example": "EN_REVISION"
          },
          "fecha_envio": {
            "type": "string",
            "description": "Fecha y hora en la que se envio la POA",
            "example": "2026-06-28T19:30:00Z"
          },
          "mensaje": {
            "type": "string",
            "description": "ID de la POA a presentar",
            "example": "uuid-poa-1234"
          }
        },
        "required": [
          "poa_id",
          "estado_anterior",
          "estado_nuevo",
          "fecha_envio",
          "mensaje"
        ]
      },
      "PresentarPoasDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PresentarPoasDataDto"
          }
        },
        "required": [
          "data"
        ]
      },
      "PresentarPoasResponseErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Titulo del error",
            "example": "Validación de Integridad Fallida"
          },
          "message": {
            "type": "string",
            "description": "Descripcion del error",
            "example": "No es posible enviar un POA vacío."
          },
          "detalles": {
            "description": "Detalles a solucionar para resolver el error",
            "example": [
              "El POA debe contener al menos 1 actividad registrada.",
              "Existen sub-actividades sin un auditor responsable asignado."
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "error",
          "message",
          "detalles"
        ]
      },
      "CancelarPoaDto": {
        "type": "object",
        "properties": {
          "poa_id": {
            "type": "string",
            "description": "ID de la POA a cancelar",
            "example": "uuid-poa-1234"
          },
          "estado_anterior": {
            "type": "string",
            "description": "Estado anterior de la POA",
            "example": "EN_REVISION"
          },
          "estado_nuevo": {
            "type": "string",
            "description": "Estado nuevo de la POA",
            "example": "BORRADOR"
          },
          "fecha_cancelacion": {
            "type": "string",
            "description": "Fecha de cancelación de la POA",
            "example": "2026-06-28T19:45:00Z"
          },
          "mensaje": {
            "type": "string",
            "description": "Mensaje de cancelación de la POA",
            "example": "El envío ha sido cancelado. El POA vuelve a estar disponible para su edición."
          }
        },
        "required": [
          "poa_id",
          "estado_anterior",
          "estado_nuevo",
          "fecha_cancelacion",
          "mensaje"
        ]
      },
      "CancelarPoaDataDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CancelarPoaDto"
          }
        },
        "required": [
          "data"
        ]
      },
      "BancoActividadesDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "ID de la actividad",
            "example": "banco-uuid-1"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo de actividad",
            "example": "AUDITORIA"
          },
          "titulo": {
            "type": "string",
            "description": "Titulo de la actividad",
            "example": "Revision al rubro de Obra Publica"
          },
          "descripcion_corta": {
            "type": "string",
            "description": "Explicacion breve de la actividad",
            "example": "Verificar el adecuado cumplimiento de los procedimientos relativos a la..."
          }
        },
        "required": [
          "id",
          "tipo",
          "titulo",
          "descripcion_corta"
        ]
      },
      "BancoActividadesDataDto": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Lista de actividades",
            "example": [
              {
                "id": 1,
                "tipo": "AUDITORIA",
                "titulo": "Revision al rubro de Obra Publica",
                "descripcion_corta": "Verificar el adecuado cumplimiento de los procedimientos relativos a la..."
              }
            ],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BancoActividadesDto"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "BancoIdDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del banco de actividades",
            "example": "banco-uuid-1"
          },
          "titulo": {
            "type": "string",
            "description": "Titulo de la actividad",
            "example": "Revisión al rubro de Obra Pública"
          },
          "justificacion_plantilla": {
            "type": "string",
            "description": "Justificación de la actividad",
            "example": "Verificar el adecuado cumplimiento a los procedimientos relativos a la planeación, programación..."
          },
          "objetivo_gen_plantilla": {
            "type": "string",
            "description": "Objetivo general de la actividad",
            "example": "Asegurar la correcta aplicación de los recursos destinados a la obra pública..."
          }
        },
        "required": [
          "id",
          "titulo",
          "justificacion_plantilla",
          "objetivo_gen_plantilla"
        ]
      },
      "ActividadSugeridaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID de la actividad sugerida",
            "example": "actividad-uuid-1"
          },
          "descripcion": {
            "type": "string",
            "description": "Descripcion de la actividad sugerida",
            "example": "Elaborar acta circunstanciada para desincorporar del Patrimonio..."
          },
          "tipo_sugerido": {
            "type": "string",
            "description": "Que tipo de actividad es la sugerida",
            "example": "AUDITORIA"
          }
        },
        "required": [
          "id",
          "descripcion",
          "tipo_sugerido"
        ]
      },
      "ActividadSugeridaDataDto": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Lista de actividades sugeridas",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActividadSugeridaDto"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "CentroDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del centro de trabajo",
            "example": "centro-uuid-1"
          },
          "clave": {
            "type": "string",
            "description": "Clave del centro universitario",
            "example": "CUCEI"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del centro universitario",
            "example": "Centro Universitario de Ciencias Exactas e Ingenierías"
          },
          "subtitulo_interfaz": {
            "type": "string",
            "description": "Subtítulo para la interfaz",
            "example": "Ciencias Exactas"
          }
        },
        "required": [
          "id",
          "clave",
          "nombre",
          "subtitulo_interfaz"
        ]
      },
      "CentroDataDto": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Lista de centros de trabajo",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CentroDto"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "AuditoresDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador unico del auditor",
            "example": "uuid-auditor-1"
          },
          "nombre_completo": {
            "type": "string",
            "description": "Nombre completo del auditor",
            "example": "Braulio Vicente Ruiz"
          },
          "cargo_etiqueta": {
            "type": "string",
            "description": "Cargo del auditor",
            "example": "Mtro. Titular"
          }
        },
        "required": [
          "id",
          "nombre_completo",
          "cargo_etiqueta"
        ]
      },
      "AuditoresDataDto": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Lista de auditores",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditoresDto"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "CentroUniversitarioDto": {
        "type": "object",
        "properties": {
          "clave": {
            "type": "string",
            "description": "Clave del centro universitario",
            "example": "CU VALLES"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del centro universitario",
            "example": "Centro Universitario de los Valles"
          }
        },
        "required": [
          "clave",
          "nombre"
        ]
      },
      "BandejaEntradaDto": {
        "type": "object",
        "properties": {
          "devueltas": {
            "type": "number",
            "description": "Número de actividades devueltas para corrección",
            "example": 3
          },
          "listas_empezar": {
            "type": "number",
            "description": "Número de actividades listas para empezar",
            "example": 4
          }
        },
        "required": [
          "devueltas",
          "listas_empezar"
        ]
      },
      "TarjetasDto": {
        "type": "object",
        "properties": {
          "bandeja_entrada": {
            "description": "Información de la bandeja de entrada",
            "allOf": [
              {
                "$ref": "#/components/schemas/BandejaEntradaDto"
              }
            ]
          },

  "info": {
    "title": "API Silverback <3",
    "description": "Especificación técnica de los endpoints para auditoría, gestión documental y reportes.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AuthLoginRequest": {
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "example": "monkeycodeinc@gmail.com",
            "description": "Correo electrónico previamente registrado"
          },
          "password": {
            "type": "string",
            "example": "Admin123!",
            "description": "Contraseña de acceso"
          }
        },
        "required": [
          "correo",
          "password"
        ]
      },
      "AuthLoginUserData": {
        "type": "object",
        "properties": {
          "rol": {
            "type": "string",
            "example": "CONTRALOR",
            "description": "Rol del usuario loggeado"
          },
          "centro_id": {
            "type": "string",
            "example": "uuid-cucei",
            "description": "UID del centro universitario"
          }
        },
        "required": [
          "rol",
          "centro_id"
        ]
      },
      "AuthLoginResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVC...",
            "description": "JWT para el envío en los headders"
          },
          "usuario": {
            "description": "Información básica del usuario autenticado.",
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthLoginUserData"
              }
            ]
          }
        },
        "required": [
          "access_token",
          "usuario"
        ]
      },
      "HttpErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "description": "Código de estado HTTP",
            "example": 401
          },
          "message": {
            "type": "object",
            "description": "Mensaje descriptivo del error",
            "example": "Credenciales inválidas"
          },
          "error": {
            "type": "string",
            "description": "Tipo de error HTTP",
            "example": "Unauthorized"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ]
      },
      "SubActividadesProximasAVencerResumen": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "sub-act-uuid-1",
            "description": "Identificador único (UUID) de la actividad"
          },
          "titulo": {
            "type": "string",
            "example": "Auditoría de Ingresos Autogenerados",
            "description": "Título de la sub-actividad próxima a vencer"
          },
          "fecha_vencimiento": {
            "type": "string",
            "example": "2026-06-19",
            "description": "Date-string con la fecha en la que se vence la sub-actividad"
          },
          "estado_semaforo": {
            "type": "string",
            "example": "A_TIEMPO",
            "description": "Estado del semáforo en la que se encuentra la sub-actividad"
          },
          "etiqueta_tiempo": {
            "type": "string",
            "example": "Faltan 2 días",
            "description": "Descripción relevante sobre la cuota de tiempo"
          }
        },
        "required": [
          "id",
          "titulo",
          "fecha_vencimiento",
          "estado_semaforo",
          "etiqueta_tiempo"
        ]
      },
      "SubActividadesProximasVencerResponse": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Array con las actividades listadas con una fecha más próxima a vencer",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubActividadesProximasAVencerResumen"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "PaginacionMetadata": {
        "type": "object",
        "properties": {
          "total_registros": {
            "type": "number",
            "example": 45,
            "description": "Total de registros encontrados en la base de datos"
          },
          "pagina_actual": {
            "type": "number",
            "example": 1,
            "description": "Página enviada en el get actual"
          },
          "total_páginas": {
            "type": "number",
            "example": 9,
            "description": "Total de páginas en las que se dividió la respuesta"
          }
        },
        "required": [
          "total_registros",
          "pagina_actual",
          "total_páginas"
        ]
      },
      "ActividadesSupervisionSubActividadInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "sub-act-1",
            "description": "Identificador único (UUID) de la sub-actividad"
          },
          "titulo": {
            "type": "string",
            "example": "Auditoría no. 055/2025 de Adquisiciones de Bienes",
            "description": "Título de la sub-actividad"
          },
          "enviada_hace": {
            "type": "string",
            "example": "Enviada hace 2 días",
            "description": "Etiqueta sobre el estado de la sub-actividad devuelta"
          }
        },
        "required": [
          "id",
          "titulo",
          "enviada_hace"
        ]
      },
      "ActividadesSupervicionGetResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "description": "Metadatos de la paginación",
            "allOf": [
              {
                "$ref": "#/components/schemas/PaginacionMetadata"
              }
            ]
          },
          "data": {
            "description": "Array con el listado de la información relevante de las sub-actividades",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActividadesSupervisionSubActividadInfo"
            }
          }
        },
        "required": [
          "meta",
          "data"
        ]
      },
      "ActividadesResumenResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "act-uuid-1",
            "description": "Identificador único (UUID) de la actividad principal"
          },
          "titulo": {
            "type": "string",
            "example": "Revisión al rubro de obra pública",
            "description": "Título de la actividad general"
          },
          "justificacion": {
            "type": "string",
            "example": "Concluir y cerrar la revisión de la auditoría no. 055/2025...",
            "description": "Justificación técnica de la actividad principal"
          },
          "objetivo_general": {
            "type": "string",
            "example": "Verificar el adecuado cumplimiento en la integración...",
            "description": "Objetivo general de la actividad principal"
          },
          "objetivos_particulares": {
            "type": "string",
            "example": "1. Revisión de bitácoras de obra y estimaciones pagadas. 2. Comprobación física de los avances de obra contra lo reportado en los informes financieros. 3. Validación de contratos y licitaciones.",
            "description": "Objetivos particulares de la actividad principal"
          },
          "meta_del_proyecto": {
            "type": "string",
            "example": "Emisión de Cédula de Observaciones y Recomendaciones del rubro de obra pública.",
            "description": "Meta registrada en la actividad principal"
          },
          "indicadores": {
            "type": "string",
            "example": "Número de obras revisadas física y documentalmente / Número de obras ejecutadas en el periodo",
            "description": "Indicadores descritos en la actividad principal"
          }
        },
        "required": [
          "id",
          "titulo",
          "justificacion",
          "objetivo_general",
          "objetivos_particulares",
          "meta_del_proyecto",
          "indicadores"
        ]
      },
      "Tipo de la sub-actividad": {
        "type": "string",
        "enum": [
          "AUDITORIA",
          "REVISION"
        ],
        "description": "Tipo definido de la sub-actividad"
      },
      "Roles Permitidos": {
        "type": "string",
        "enum": [
          "JEFA",
          "CONTRALOR",
          "AUDITOR"
        ],
        "description": "Rol del cual viene el get"
      },
      "ActividadesDirectorioAsignacion": {
        "type": "object",
        "properties": {
          "tipo_vista": {
            "example": "JEFA",
            "description": "Rol del cual viene el get",
            "allOf": [
              {
                "$ref": "#/components/schemas/Roles Permitidos"
              }
            ]
          },
          "centro_clave": {
